# Copy to .env for local development: cp .env.example .env
# On the server these go in /etc/my-phuong.env instead (see deploy/README.md).

# Password for the staff bookings page (/admin).
ADMIN_PASSWORD=change-me

# Signs the login cookie. Generate one with: openssl rand -hex 32
SESSION_SECRET=change-me-too

# Optional
# PORT=3000
# DATABASE_PATH=data/bookings.db
